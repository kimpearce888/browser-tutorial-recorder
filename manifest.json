{
  "manifest_version": 3,
  "name": "Browser Tutorial Recorder",
  "version": "1.0.1",
  "description": "Record browser actions and turn them into polished, privacy-safe step-by-step tutorials.",
  "action": {
    "default_title": "Browser Tutorial Recorder",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs", "storage", "scripting", "downloads", "unlimitedStorage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "start-recording": {
      "suggested_key": { "default": "Alt+Shift+R", "mac": "Alt+Shift+R" },
      "description": "Start recording"
    },
    "stop-recording": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "Stop recording"
    },
    "pause-resume": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "Pause or resume recording"
    },
    "open-dashboard": {
      "suggested_key": { "default": "Ctrl+Shift+D", "mac": "Command+Shift+D" },
      "description": "Open the tutorial dashboard"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
